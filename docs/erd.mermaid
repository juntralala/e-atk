---
title: Warehouse Management System ERD
config:
  theme: neutral
  layout: elk
---
erDiagram
    roles ||--o{ users : "assigned to"
    barang ||--o{ permintaan_barang_detail : "recorded in"
    barang ||--|| satuan : "measured by"
    users ||--o{ permintaan_barang : "creates request"
    users ||--o{ permintaan_barang : "responds to request"
    users ||--o{ penambahan_barang : "performs addition"
    permintaan_barang ||--o{ permintaan_barang_detail : "has details"
    penambahan_barang ||--o{ penambahan_barang_detail : "has details"
    barang ||--o{ penambahan_barang_detail : "added to"
    
    roles {
        id VARCHAR(100) PK
        name VARCHAR(100) UK
    }
    
    users {
        id VARCHAR(100) PK
        name VARCHAR(255)
        username VARCHAR(255) UK
        password VARCHAR(100)
        role_id VARCHAR(100) FK
        profile_photo_path VARCHAR(100)
        created_at DATETIME
        updated_at DATETIME 
        deleted_at DATETIME 
    }
    
    notifications {
        id VARCHAR(100) PK
        type VARCHAR(100) 
        notifiable_id CHAR(64)
        notifiable_type VARCHAR(255)
        data TEXT
        read_at DATETIME
        created_at DATETIME 
        updated_at DATETIME 
    }
    
    items {
        id VARCHAR(100) PK 
        name VARCHAR(100)
        unit_id VARCHAR(100) FK 
        specification_name VARCHAR(255) 
        stock INTEGER 
        price DECIMAL(20_2)
        created_at DATETIME 
        updated_at DATETIME 
        deleted_at DATETIME 
    }

    settings {
        id VARCHAR(100) PK
        icon VARCHAR(500)
        logo VARCHAR(500)
        application_name VARCHAR(255) 
        institution_name VARCHAR(255)
        institution_address TEXT 
        institution_phone VARCHAR(20)
        created_at DATETIME 
        updated_at DATETIME 
    }
    
    units {
        id VARCHAR(100) PK 
        name VARCHAR(255)
        created_at DATETIME 
        updated_at DATETIME 
        deleted_at DATETIME
    }
    
    item_requests {
        id VARCHAR(100) PK 
        requester_id VARCHAR(100) FK 
        status ENUM 
        request_date DATE
        responder_id VARCHAR(100) FK 
        responder_notes TEXT 
        response_date DATE
        created_at DATETIME 
        updated_at DATETIME 
    }
    
    item_request_details {
        id VARCHAR(100) PK  
        item_request_id VARCHAR(100) FK 
        item_id VARCHAR(100) 
        requested_quantity INTEGER 
        received_quantity INTEGER 
        price DECIMAL(20_2)
        created_at DATETIME
        updated_at DATETIME
    }
    
    item_additions {
        id VARCHAR(100) PK
        user_id VARCHAR(100) FK 
        addition_date DATE
        created_at DATETIME 
    }
    
    item_addition_details {
        id VARCHAR(100) PK  
        item_addition_id VARCHAR(100) FK
        item_id VARCHAR(100) FK
        quantity INTEGER 
        price DECIMAL(20_2)
        created_at DATETIME
    }